/* ============================================
   我的照片页面 - 样式
   ============================================ */

/* -------- 页面容器 -------- */
.container {
  padding: 16px;
  min-height: 100vh;
  box-sizing: border-box;
  background: #F7F7F7;
}

/* -------- 分区 -------- */
.section {
  margin-bottom: 24px;
}

.section-title {
  font-size: 13px;
  font-weight: 600;
  color: #8E8E93;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 10px;
  padding-left: 4px;
}

/* -------- 照片卡片 -------- */
.photo-card {
  width: 100%;
  aspect-ratio: 1 / 1;
  max-height: 360px;
  background: #FFFFFF;
  border-radius: 16px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.photo-image {
  width: 100%;
  height: 100%;
}

/* -------- 空状态 / 加载 -------- */
.empty-card,
.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48px 24px;
  background: #FFFFFF;
  border-radius: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  text-align: center;
}

.empty-icon {
  font-size: 56px;
  margin-bottom: 12px;
  opacity: 0.4;
}

.empty-text {
  font-size: 17px;
  font-weight: 500;
  color: #1C1C1E;
  margin-bottom: 6px;
}

.empty-sub {
  font-size: 14px;
  color: #8E8E93;
  line-height: 1.5;
}

.loading-spinner {
  width: 32px;
  height: 32px;
  border: 3px solid #E5E5EA;
  border-top: 3px solid #007AFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 12px;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* -------- 内容安全审核状态卡片 -------- */
.status-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24px 20px;
  background: #FFFFFF;
  border-radius: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  text-align: center;
}

.status-card.rejected {
  background: #FFF5F5;
}

.status-photo {
  width: 120px;
  height: 120px;
  border-radius: 12px;
  margin-bottom: 14px;
  opacity: 0.6;
}

.status-icon {
  font-size: 40px;
  line-height: 1;
  margin-bottom: 10px;
}

.status-title {
  font-size: 17px;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 8px;
}

.status-card.rejected .status-title {
  color: #FF3B30;
}

.status-sub {
  font-size: 13px;
  color: #8E8E93;
  line-height: 1.6;
  margin-bottom: 4px;
}

.btn-small {
  height: 38px;
  padding: 0 20px;
  font-size: 14px;
  margin-top: 14px;
}

/* -------- 内容安全说明 -------- */
.upload-hint {
  font-size: 12px;
  color: #8E8E93;
  line-height: 1.5;
  text-align: center;
  margin-top: -2px;
}

/* -------- 性别选择 -------- */
.gender-row {
  display: flex;
  gap: 12px;
}

.gender-btn {
  flex: 1;
  height: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 2px solid #E5E5EA;
  border-radius: 12px;
  font-size: 16px;
  color: #1C1C1E;
  transition: all 0.2s;
}

.gender-btn.active-male {
  border-color: #007AFF;
  background: #EBF5FF;
  color: #007AFF;
  font-weight: 600;
}

.gender-btn.active-female {
  border-color: #FF2D55;
  background: #FFF0F3;
  color: #FF2D55;
  font-weight: 600;
}

.gender-hint {
  text-align: center;
  margin-top: 10px;
  font-size: 13px;
  color: #FF9500;
}

/* -------- 操作按钮 -------- */
.actions {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
  border: none;
}

.btn:active {
  opacity: 0.7;
}

.btn-primary {
  background: #007AFF;
  color: #FFFFFF;
}

.btn-danger {
  background: #FF3B30;
  color: #FFFFFF;
}

.btn-outline {
  background: transparent;
  color: #007AFF;
  border: 1.5px solid #007AFF;
}

.btn-text {
  background: transparent;
  color: #8E8E93;
  font-size: 15px;
  font-weight: 400;
  height: 40px;
}

/* -------- 解锁进度提示 -------- */
.score-hint {
  text-align: center;
  font-size: 13px;
  color: #8E8E93;
  line-height: 1.6;
  margin-top: -2px;
}

.score-hint.unlocked {
  color: #34C759;
}

/* -------- 分数弹窗 -------- */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #FFFFFF;
  border-radius: 20px;
  padding: 32px 24px;
  width: 300px;
  text-align: center;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
}

.modal-title {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 16px;
  color: #1C1C1E;
}

.score-big {
  font-size: 72px;
  font-weight: 700;
  color: #007AFF;
  line-height: 1;
  margin-bottom: 4px;
}

.score-label {
  font-size: 15px;
  color: #8E8E93;
  margin-bottom: 6px;
}

.score-count {
  font-size: 14px;
  color: #8E8E93;
}

.no-score-text {
  font-size: 16px;
  color: #1C1C1E;
  margin-bottom: 8px;
}

.no-score-sub {
  font-size: 14px;
  color: #8E8E93;
}

/* -------- 全站排名 -------- */
.rank-box {
  margin-top: 20px;
  padding: 14px 12px;
  background: #F2F7FF;
  border-radius: 14px;
}

.rank-main {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.rank-label {
  font-size: 13px;
  color: #8E8E93;
  margin-right: 6px;
}

.rank-value {
  font-size: 26px;
  font-weight: 700;
  color: #007AFF;
  line-height: 1.1;
}

.rank-unit {
  font-size: 12px;
  color: #8E8E93;
  margin-left: 6px;
}

.rank-sub {
  margin-top: 6px;
  font-size: 12px;
  color: #8E8E93;
}

/* -------- 未解锁弹窗 -------- */
.lock-icon {
  font-size: 44px;
  line-height: 1;
  margin-bottom: 10px;
}

.lock-text {
  font-size: 14px;
  color: #8E8E93;
  line-height: 1.7;
  margin-bottom: 18px;
}

.lock-progress-bar {
  height: 8px;
  background: #E5E5EA;
  border-radius: 4px;
  overflow: hidden;
}

.lock-progress-fill {
  height: 100%;
  background: #007AFF;
  border-radius: 4px;
  transition: width 0.3s ease;
}

.lock-progress-text {
  margin-top: 10px;
  font-size: 13px;
  font-weight: 500;
  color: #1C1C1E;
}

.modal-actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 24px;
}
