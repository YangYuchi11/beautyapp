<!--
  颜值评价（真人打分） - 我的照片页面
  功能：上传照片 / 查看分数 / 删除照片 / 性别设置
-->
<view class="container">
  <!-- 1. 我的照片展示区 -->
  <view class="section">
    <view class="section-title">我的照片</view>

    <view class="photo-card" wx:if="{{hasPhoto}}">
      <image
        class="photo-image"
        src="{{photoUrl}}"
        mode="aspectFill"
      />
    </view>

    <!-- 空状态 -->
    <view class="empty-card" wx:if="{{!hasPhoto && !loading}}">
      <view class="empty-icon">📷</view>
      <view class="empty-text">暂无照片</view>
      <view class="empty-sub">上传一张照片，让其他人来评价你的颜值吧！</view>
    </view>

    <!-- 加载中 -->
    <view class="loading-card" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>
  </view>

  <!-- 2. 性别设置 -->
  <view class="section">
    <view class="section-title">我的性别</view>
    <view class="gender-row">
      <view
        class="gender-btn {{gender === 'male' ? 'active-male' : ''}}"
        bindtap="onGenderSelect"
        data-gender="male"
      >🙋‍♂️ 男</view>
      <view
        class="gender-btn {{gender === 'female' ? 'active-female' : ''}}"
        bindtap="onGenderSelect"
        data-gender="female"
      >🙋‍♀️ 女</view>
    </view>
    <view class="gender-hint" wx:if="{{!gender}}">
      请先设置性别后再上传照片
    </view>
  </view>

  <!-- 3. 操作区 -->
  <view class="section actions">
    <!-- 上传照片 -->
    <view
      class="btn btn-primary"
      bindtap="onUploadPhoto"
    >{{hasPhoto ? '重新上传照片' : '上传照片'}}</view>

    <!-- 查看分数 -->
    <view class="btn btn-outline" bindtap="onViewScore" wx:if="{{hasPhoto}}">
      查看我的分数
    </view>

    <!-- 解锁进度提示 -->
    <view class="score-hint {{canViewScore ? 'unlocked' : ''}}" wx:if="{{hasPhoto}}">
      <block wx:if="{{canViewScore}}">✓ 已解锁 · 已为 {{givenCount}} 张照片打分</block>
      <block wx:else>再给 {{remainCount}} 张照片打分，即可查看分数与排名（{{givenCount}}/{{requiredCount}}）</block>
    </view>

    <!-- 删除照片 -->
    <view class="btn btn-danger" bindtap="onDeletePhoto" wx:if="{{hasPhoto}}">
      删除照片
    </view>
  </view>

  <!-- 4. 分数弹窗 -->
  <view class="modal-mask" wx:if="{{showScoreModal}}" bindtap="onCloseScoreModal">
    <view class="modal-content" catchtap>
      <view class="modal-title" wx:if="{{hasRatings}}">我的颜值评分</view>
      <view class="modal-title" wx:else>暂无评分</view>

      <view wx:if="{{hasRatings}}">
        <view class="score-big">{{averageScore}}</view>
        <view class="score-label">平均分</view>
        <view class="score-count">共 {{totalCount}} 人打分</view>

        <!-- 全站排名 -->
        <view class="rank-box" wx:if="{{rank}}">
          <view class="rank-main">
            <text class="rank-label">全站排名</text>
            <text class="rank-value">第 {{rank}} 名</text>
            <text class="rank-unit">/ 共 {{rankTotal}} 人</text>
          </view>
          <view class="rank-sub" wx:if="{{beatPercent > 0}}">
            超过了 {{beatPercent}}% 的用户
          </view>
        </view>
      </view>

      <view wx:else>
        <view class="no-score-text">还没有人给你打分</view>
        <view class="no-score-sub">快去给别人打分吧！</view>
      </view>

      <view class="btn btn-primary" style="margin-top:20px" bindtap="onCloseScoreModal">
        知道了
      </view>
    </view>
  </view>

  <!-- 5. 未解锁提示弹窗 -->
  <view class="modal-mask" wx:if="{{showLockModal}}" bindtap="onCloseLockModal">
    <view class="modal-content" catchtap>
      <view class="lock-icon">🔒</view>
      <view class="modal-title">分数与排名还未解锁</view>
      <view class="lock-text">
        <view>先累计给 {{requiredCount}} 张照片打分</view>
        <view>才能查看自己的分数和全站排名</view>
      </view>

      <!-- 进度条 -->
      <view class="lock-progress">
        <view class="lock-progress-bar">
          <view class="lock-progress-fill" style="width: {{progressPercent}}%"></view>
        </view>
        <view class="lock-progress-text">
          已评价 {{givenCount}} / {{requiredCount}} 张，还差 {{remainCount}} 张
        </view>
      </view>

      <view class="modal-actions">
        <view class="btn btn-primary" bindtap="onGoRating">去打分</view>
        <view class="btn btn-text" bindtap="onCloseLockModal">稍后再说</view>
      </view>
    </view>
  </view>
</view>
